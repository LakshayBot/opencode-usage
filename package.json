{
  "name": "@skinnysheep/opencode-usage",
  "version": "0.1.7",
  "description": "Track OpenCode token usage, cache statistics and estimated costs across all your projects. Global /usage slash command.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/LakshayBot/opencode-usage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakshayBot/opencode-usage.git"
  },
  "bugs": {
    "url": "https://github.com/LakshayBot/opencode-usage/issues"
  },
  "keywords": [
    "opencode",
    "usage",
    "tokens",
    "cost",
    "cache",
    "plugin"
  ],
  "engines": {
    "node": ">=23.4.0"
  },
  "bin": {
    "opencode-usage": "dist/cli/entry.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./plugin/server": "./dist/plugin/plugin-server.js",
    "./plugin/tui": "./dist/plugin/plugin-tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "scripts/postinstall.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@opentui/keymap": "^0.5.3",
    "@opentui/solid": "0.5.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  }
}
